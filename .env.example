# Universal Admin Dashboard
# Canonical development defaults (server-side only).

ADMIN_DASHBOARD_CONFIG=./path/to/admin-dashboard.config.json
ADMIN_BUSINESS_PROFILE=generic
ADMIN_AUTH_PROVIDER=memory
ADMIN_AUTH_USER_JSON={"id":"example-user","role":"admin"}
ADMIN_AUTH_USER_ID=example-user-id
ADMIN_AUTH_EMAIL=admin@example.invalid
ADMIN_AUTH_ROLE=admin
ADMIN_AUTH_TENANT_ID=example-tenant-id
ADMIN_AUTH_PERMISSIONS=["example:permission"]
ADMIN_SIDECAR_BASE_URL=http://localhost:4100
ADMIN_PUBLIC_BASE_PATH=/admin